# Python cache and compiled files
__pycache__/
*.py[cod]

# Virtual environments
.venv/
venv/
env/

# The instance directory: the live database, the real .env and the secrets.
# Only the example and the empty secrets folder are tracked.
instance/*
!instance/.env.example
!instance/secrets/
instance/secrets/*
!instance/secrets/.gitkeep
!instance/secrets/README.md
*.db
*.sqlite3

# ...except the ready-made demo database, which is meant to be shipped.
!demo/example/app.db

# Environment and local config
.env
.env.*
!instance/.env.example

# Test and tooling caches
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# IDE and OS files
.vscode/
.idea/
Thumbs.db
.DS_Store

# Frontend: dependencies, and the build output Vite writes into the backend.
frontend/node_modules/
backend/app/static/client/
