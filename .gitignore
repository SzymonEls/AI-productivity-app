# Python cache and compiled files
__pycache__/
*.py[cod]

# Virtual environments
.venv/
venv/
env/

# Flask instance data and local databases
instance/*
!instance/.env.example
!instance/secrets/
!instance/secrets/.gitkeep
!instance/secrets/README.md
app/instance/*
!app/instance/.env.example
!app/instance/secrets/
!app/instance/secrets/.gitkeep
!app/instance/secrets/README.md
*.db
*.sqlite3

# ...except the ready-made demo database, which is meant to be shipped.
!demo/example/app.db

# Environment and local config
.env
.env.*
!app/instance/.env.example
instance/.env
instance/secrets/*
!instance/secrets/.gitkeep
!instance/secrets/README.md
app/instance/.env
app/instance/secrets/*
!app/instance/secrets/.gitkeep
!app/instance/secrets/README.md

# Test and tooling caches
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# IDE and OS files
.vscode/
.idea/
Thumbs.db
.DS_Store

# Frontend client: dependencies and build output stay out of the repo.
client/node_modules/
app/static/client/
