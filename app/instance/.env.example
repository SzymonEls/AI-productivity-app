# Example environment variables file.
# Copy it to app/instance/.env and fill it in.
#   cp app/instance/.env.example app/instance/.env
# The app reads app/instance/.env first, then .env in the repo root.

# --- Application settings (read in config.py) ---

# Key used to sign sessions. IN PRODUCTION set a long, random secret.
SECRET_KEY=change-me

# Database address. Defaults to a local SQLite file at app/instance/app.db.
DATABASE_URL=sqlite:///app/instance/app.db

# Whether new accounts can register (true/false).
REGISTRATION_ENABLED=true

# How many days to keep the "remember me" session. A stolen cookie stays usable
# for this long, so shorter is safer; changing the password revokes it at once.
REMEMBER_COOKIE_DAYS=30

# Restrict the session cookies to HTTPS. Leave at true for anything reachable
# over a network. Set it to false ONLY when the app is genuinely served over
# plain http - including a reverse proxy that does not terminate TLS - because
# with it on, such a deployment can never complete a login.
# `python run.py` turns it off by itself; `flask --app run.py run` does not.
SECURE_COOKIES=true

# Version shown in the app. Empty = read from the VERSION file.
APP_VERSION=

# Pre-fill the login form (handy on a self-hosted server).
# Leave empty if you don't want to suggest login credentials.
DEFAULT_LOGIN_EMAIL=
DEFAULT_LOGIN_PASSWORD=

# Timezone used to determine "day" boundaries in time tracking.
CALENDAR_TIMEZONE=Europe/Warsaw

# How many failed sign-ins are allowed before the door shuts, and for how many
# minutes it stays shut. Counted per email address, so three wrong passwords
# lock that account for five minutes no matter where they are tried from. A
# correct password clears the count.
LOGIN_MAX_ATTEMPTS=3
LOGIN_BLOCK_MINUTES=5

# How long a deleted row's tombstone is kept before it is cleared away for good.
# The content of a deleted row is emptied immediately, whatever this says; what
# is kept is the bare fact that it is gone, so another device can find out. The
# window is about devices, not disk space: a device away for longer than this is
# sent the whole set on its next sync instead of a list of changes.
TOMBSTONE_RETENTION_DAYS=90

# Read, but CURRENTLY UNUSED by the app (reserved for a future AI feature).
OPENAI_API_KEY=

# --- Read-only demo (leave off for a normal installation) ---
# Turns this instance into a public demo: every write is refused, the login page
# renders DEMO_DOC_PATH below the form, and a banner sits above every page.
# While this is off, none of it is wired up at all - see app/demo.py.
# Never point a public URL at an instance with this off: the app has no CSRF
# protection, which is only harmless because every write is refused.
DEMO_MODE=false

# Markdown file rendered on the login page, relative to the repo root.
DEMO_DOC_PATH=README.md

# Relative links in that file are rewritten to this address so they resolve.
DEMO_DOC_BASE_URL=https://github.com/SzymonEls/AI-productivity-app/blob/main/

# Message shown when a visitor tries to save something.
DEMO_BLOCK_MESSAGE=Demo mode - changes are disabled.

# Text of the banner above every page. An empty value removes the banner.
DEMO_BANNER_MESSAGE=Read-only portfolio demo — nothing you change here is saved.

# Set to 1 to disable the automatic database update at app startup.
# In Docker it is set to 1 (migrations run via docker-entrypoint.sh). Leave empty locally.
# SKIP_DB_BOOTSTRAP=1

# --- Settings used only when running in Docker ---

# Number of Gunicorn worker processes and its timeout.
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120
